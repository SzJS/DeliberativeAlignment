# Regenerated by the pipeline
data/
artifacts/

# Local venv + caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# NOTE: uv.lock is deliberately NOT ignored (unlike dr_rrc_replication, where it
# is — an oversight there). The lock file is the committed record of a resolved,
# working environment; the pyproject ranges only express constraints. Ignoring it
# throws away the reproducibility it exists to provide.

# `outputs/` (generations + tee'd terminal logs) is ignored by the repo-root
# .gitignore, whose `outputs/` pattern matches at any depth. Not repeated here.
